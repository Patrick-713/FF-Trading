# Local development defaults. Node does not automatically load this file.
PORT=3000
HOST=127.0.0.1
# DB_PATH=data/ff-trading.sqlite
# Production requires DATABASE_URL. Use a pooled Neon URL for application traffic.
# DATABASE_URL=postgresql://role:password@host-pooler.neon.tech/ff_trading?sslmode=verify-full
# Cloud migrations use a direct URL in a separate ignored env file.
# COOKIE_SECURE=true
# Optional exact public origin. Otherwise Vercel checks the current HTTPS host.
# APP_ORIGIN=https://your-production-domain.vercel.app

# Account email delivery. Keep the API key secret and restricted to the sending domain.
# RESEND_API_KEY=
# EMAIL_FROM=FF Trading <accounts@mail.fantasyfootballmarket.app>
# EMAIL_APP_ORIGIN=https://fantasyfootballmarket.app
